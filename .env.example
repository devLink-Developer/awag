# Generate real values with: python scripts/generate-env.py
DATABASE_URL=postgresql+psycopg://gateway@127.0.0.1:5432/gateway
REDIS_URL=redis://127.0.0.1:6379/0
POSTGRES_PASSWORD=
REDIS_PASSWORD=
API_TOKEN=
INSTANCE_NAME="WhatsApp QA"
INSTANCE_PHONE_NUMBER=
ADB_SERIAL=emulator-5554
ADB_HOST=127.0.0.1
ADB_PORT=5037
ADB_BINARY=adb
APPIUM_URL=http://127.0.0.1:4723
SYSTEM_PORT=8200
WHATSAPP_PACKAGE=com.whatsapp
UI_LANGUAGE=es
DEBUG_AUTOMATION=false
INCOMING_DIR=/data/incoming
MEDIA_DIR=/data/media
SCREENSHOT_DIR=/data/screenshots
IMAGE_LIMIT_BYTES=10485760
AV_LIMIT_BYTES=16777216
DOCUMENT_LIMIT_BYTES=104857600
LOCK_TTL_SECONDS=90
LOCK_RENEW_SECONDS=15
COMMAND_TIMEOUT_SECONDS=25
UI_WAIT_SECONDS=20
SEND_WAIT_SECONDS=120
TASK_TIME_LIMIT_SECONDS=300
STALE_PROCESSING_SECONDS=360
MAX_ATTEMPTS=3
HEALTH_INTERVAL_SECONDS=60
DEBUG_TIMEOUT_SECONDS=10
# Paths on the Ubuntu host. Keep Android data outside Docker.
HOST_DATA_DIR=./data
